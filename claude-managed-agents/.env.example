# Scalekit — from Scalekit Dashboard → Settings
SCALEKIT_ENV_URL=https://your-environment.scalekit.com
SCALEKIT_CLIENT_ID=your_client_id
SCALEKIT_CLIENT_SECRET=your_client_secret

# Anthropic — from https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_ENVIRONMENT_ID=your_environment_id
